# ============================================================
# ELA AI — variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs.
# `.env` n'est JAMAIS versionné (voir .gitignore).
#
# Règles de syntaxe :
#  - une variable laissée vide (VAR=) prend sa valeur par défaut ;
#  - pas de commentaire sur la même ligne qu'une valeur vide ;
#  - entourer de guillemets simples toute valeur contenant `$`
#    (hash bcrypt par exemple) : VAR='$2b$12$...'
# ============================================================

# ---------- Application ----------
# dev | prod
ELA_ENV=dev
LOG_LEVEL=INFO
# Adresse publique servie par Caddy (HTTPS automatique) :
#  - nom de domaine -> certificat Let's Encrypt (ex: ela.univ-orleans.fr)
#  - adresse IP ou localhost -> certificat auto-signé (avertissement navigateur)
SITE_ADDRESS=localhost
# Secret de session Chainlit : générer avec `chainlit create-secret`
CHAINLIT_AUTH_SECRET=
# Nombre maximal d'images par message (Cerebras : 2 en Free Trial, 10 en Developer)
MAX_IMAGES_PER_MESSAGE=2

# ---------- PostgreSQL ----------
POSTGRES_USER=chainlit_user
POSTGRES_PASSWORD=
POSTGRES_DB=chainlit_db
# Exécution LOCALE (hors Docker) uniquement : Docker Compose écrase ces deux
# URLs pour pointer vers le service `db`.
DATABASE_URL=postgresql+asyncpg://chainlit_user:CHANGE_ME@localhost:5432/chainlit_db
ADMIN_DATABASE_URL=postgresql://chainlit_user:CHANGE_ME@localhost:5432/chainlit_db

# ---------- LLM : fournisseurs (tous compatibles OpenAI) ----------
# cerebras | ilaas | groq
LLM_PROVIDER=cerebras
# Fournisseur du modèle vision / du modèle de secours (vide = LLM_PROVIDER)
LLM_VISION_PROVIDER=
LLM_FALLBACK_PROVIDER=

# Modèle texte : agent (appels d'outils requis), quiz, exercices, résumé, atelier code
LLM_MODEL_CHAT=gpt-oss-120b
# Modèle multimodal : transcrit les images jointes (équations, tableaux, graphiques) pour l'agent texte
LLM_MODEL_VISION=qwen-3.8-27b
# Modèle de secours (texte, pris par l'agent si le modèle principal échoue). `none` pour désactiver.
LLM_MODEL_FALLBACK=qwen-3.8-27b

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
# Effort de raisonnement : gpt-oss -> low | medium | high ; qwen -> none | low | medium | high
# `omit` = paramètre non envoyé. Ignoré automatiquement pour Groq.
LLM_REASONING_EFFORT=low

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ILaaS — https://www.ilaas.fr (clé fournie par le consortium)
ILAAS_API_KEY=
# URL du service d'inférence (chat) — à obtenir auprès d'ILaaS
ILAAS_CHAT_BASE_URL=
# Service d'embeddings bge-m3 (utilisé à partir de la phase 2)
ILAAS_EMBED_BASE_URL=https://rag-api.ilaas.fr/v1

# Groq — conservé en option (modèles texte uniquement)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------- Base de connaissances (ingestion, embeddings, store, retrieval) ----------
LATEX_SOURCE_DIR=./data/latex
# Annales (sujets d'examen et corrigés, même arborescence) : stockées depuis le backoffice, indexation à venir
ANNALES_SOURCE_DIR=./data/annales
# Embeddings : local = sentence-transformers sur CPU (BAAI/bge-m3, 1024 dims, telecharge ~2,2 Go
# au premier lancement) ; ilaas = API d'embeddings ILaaS (meme modele, cle ILAAS_API_KEY) ;
# openai = tout autre service compatible OpenAI (EMBEDDING_BASE_URL + EMBEDDING_API_KEY).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# En cas de panne de l'API, charger le meme modele en local (vecteurs compatibles)
EMBEDDING_LOCAL_FALLBACK=true

# Store : pgvector = table rag_chunks dans DATABASE_URL (recherche hybride SQL, recommande ;
# necessite l'extension pgvector) ; chroma = dossier local + BM25 (sans extension PostgreSQL).
RETRIEVAL_BACKEND=pgvector
CHROMA_DB_PATH=./data/chroma_db
# Candidats par branche avant reranking (union des deux branches), quota de chunks de manuscrit
# (HDR, articles) parmi les candidats, maximum de manuscrits dans le top-n final, poids plein texte
RETRIEVAL_K=20
RETRIEVAL_MANUSCRIPT_K=4
RETRIEVAL_MANUSCRIPT_MAX=1
RETRIEVAL_LEXICAL_WEIGHT=0.5

# Reranking : none = ordre de fusion (meilleure configuration mesurée le 17/10 avec bge-m3 :
# any-hit@5 0,94, MRR 0,74, 0,25 s/question) ; flashrank = cross-encoder ONNX
# (ms-marco-MiniLM-L-12-v2 : 0,88 ; ms-marco-MultiBERT-L-12 : 0,59 — a eviter) ;
# local = CrossEncoder sentence-transformers (BAAI/bge-reranker-v2-m3, non mesure, ~2-4 s CPU).
RERANK_PROVIDER=none
RERANK_MODEL=
RERANK_TOP_N=5

# Decoupage : taille cible des paragraphes de manuscrit, limite dure par chunk, notes \note{}
CHUNK_TARGET_CHARS=1200
CHUNK_MAX_CHARS=2500
INGEST_INCLUDE_NOTES=true

# ---------- Agent (phase 3) ----------
# Version des prompts (fichiers src/ela/agent/prompts/<nom>_<version>.md), inscrite dans les traces et rapports
PROMPT_VERSION=v1
# Limites par message étudiant : appels modèle, appels d'outils (tous), recherches search_course
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_SEARCHES=4
# Extraits renvoyés par search_course (défaut et plafond de l'argument k)
AGENT_SEARCH_K=5
AGENT_SEARCH_K_MAX=8
# Budget de caractères du plan de cours (get_course_outline)
AGENT_OUTLINE_MAX_CHARS=6000
# Résumer (un appel modèle, mis en cache par session) les tours qui sortent de la fenêtre d'historique
AGENT_SUMMARY_ENABLED=true

# ---------- Traçage Langfuse (optionnel, désactivé si les clés sont vides) ----------
# Langfuse Cloud (https://cloud.langfuse.com) ou instance auto-hébergée (LANGFUSE_HOST).
# En production, ne pas activer vers le cloud avec des données étudiantes.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Joindre l'identifiant de l'étudiant aux traces (false = traces anonymes, identifiant de fil seulement)
LANGFUSE_SEND_USER_ID=false

# ---------- Atelier Code 2.0 : exécution des scripts (optionnel) ----------
# URL du service apps/sandbox (service `sandbox` du docker-compose : http://sandbox:8080).
# Vide = les scripts sont générés mais jamais exécutés (bouton « Exécuter » absent).
SANDBOX_URL=
# Durée maximale d'une exécution (s) et nombre d'exécutions par étudiant et par jour (0 = illimité)
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_DAILY_QUOTA=10
# Atelier Code : budget de tokens et effort de raisonnement pour générer / corriger / interpréter les scripts
CODE_MAX_TOKENS=4096
CODE_REASONING_EFFORT=medium
# Après un échec d'exécution : une correction automatique puis ré-exécution avant d'afficher l'erreur
# (coûte une exécution de quota supplémentaire)
CODE_AUTO_FIX=true

# ---------- Évaluation (ela-eval answer) ----------
# Modèle juge (vide = LLM_MODEL_CHAT) et son effort de raisonnement
EVAL_JUDGE_MODEL=
EVAL_JUDGE_REASONING_EFFORT=medium

# ---------- Authentification et nouveau backoffice (phase 5) ----------
# Fournisseur d'identité : local = comptes de la table users (mot de passe bcrypt) ;
# cas = CAS de l'université (prévu, pas encore disponible)
AUTH_PROVIDER=local
# Secret de signature des sessions du backoffice FastAPI (OBLIGATOIRE pour le démarrer) :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKOFFICE_SECRET_KEY=
# Préfixe d'URL du backoffice (identique en local et derrière Caddy) ; durée de session ; fuseau d'affichage
BACKOFFICE_ROOT_PATH=/backoffice
BACKOFFICE_SESSION_HOURS=8
BACKOFFICE_TIMEZONE=Europe/Paris
# Verrouillage temporaire d'un identifiant après N échecs de connexion (0 = jamais)
BACKOFFICE_LOGIN_MAX_FAILURES=5
BACKOFFICE_LOGIN_LOCK_MINUTES=15

# ---------- Backoffice Streamlit (/admin, protection par le reverse proxy Caddy) ----------
# Hash bcrypt généré avec :  ela-hash --caddy
# (ou : docker run --rm caddy:2 caddy hash-password --plaintext '...')
# Garder les guillemets simples autour du hash.
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_HASH=''
