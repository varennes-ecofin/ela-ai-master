# ============================================================
# ELA AI — .gitignore
# ============================================================

# --- Secrets & configuration locale (JAMAIS versionnés) ---
.env
.env.*
!.env.example
**/secrets.toml
**/.streamlit/secrets.toml
*.pem
*.key
vpslog.txt
hashhistory.txt*
backoffice_deploy.txt*
*.bak
*.backup

# --- Notes de travail, médias, anciens scripts (hors code source) ---
Other/

# --- Données runtime : cours LaTeX (propriété intellectuelle), base vectorielle,
#     modèles téléchargés (reranker), exports de chunks... Tout `data/` reste hors du dépôt.
data/
chroma_db/
latex/
.files_ela/
.files/
*.jsonl

# --- Chainlit : fichiers générés (on versionne uniquement config.toml) ---
.chainlit/*
!.chainlit/config.toml

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# --- Éditeurs / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
eval/reports/*.json
